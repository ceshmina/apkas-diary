{
  "name": "apkas-diary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "個人の日記サイト。DynamoDB を正として静的サイトを生成し、S3 + CloudFront で配信する。",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "scripts/build.sh",
    "preview": "astro preview",
    "deploy": "scripts/deploy.sh",
    "entry": "scripts/entry.sh",
    "photo": "scripts/photo.sh",
    "import-legacy": "scripts/import-legacy.sh",
    "deploy:lambda": "scripts/deploy-lambda.sh",
    "dev:editor": "scripts/dev-editor.sh",
    "deploy:editor": "scripts/deploy-editor.sh",
    "check": "astro check && astro check --config editor/astro.config.ts && biome check . && scripts/check-lambda.sh",
    "format": "biome check --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ceshmina/apkas-diary.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.5",
    "@astrojs/node": "^11.1.0",
    "@aws-sdk/client-codebuild": "^3.1107.0",
    "@aws-sdk/client-dynamodb": "^3.1101.0",
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/client-ssm": "^3.1106.0",
    "@aws-sdk/lib-dynamodb": "^3.1101.0",
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
