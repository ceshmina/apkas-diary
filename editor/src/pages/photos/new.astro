---
import { isValidDate, todayJst } from '../../../../src/lib/date.js'
import Base from '../../layouts/Base.astro'
import { createUploadTicket, MAX_UPLOAD_BYTES } from '../../lib/photo-upload.js'

export const prerender = false

const session = Astro.locals.session

// 一時的な資格が載るページなので、どこにも残さない。
Astro.response.headers.set('Cache-Control', 'no-store')

const requested = Astro.url.searchParams.get('date')
const invalidDate = requested !== null && !isValidDate(requested)
const date = requested !== null && isValidDate(requested) ? requested : todayJst()

// 戻り先は画面のリンクにしか使わず、**自動では飛ばさない**。値も編集画面に限る。
// 任意の URL を通すと、認証を通った先から外へ誘導できる経路になる。
const rawReturn = Astro.url.searchParams.get('return')
const returnTo = rawReturn?.startsWith('/entries/') ? rawReturn : undefined

let ticket: Awaited<ReturnType<typeof createUploadTicket>> | undefined
let ticketError: string | undefined

try {
  ticket = await createUploadTicket(date)
} catch (error) {
  ticketError = error instanceof Error ? error.message : String(error)
}

const maxMegabytes = Math.floor(MAX_UPLOAD_BYTES / 1024 / 1024)

/** 送り終えたあとに向かう先。キーはスクリプトが足す。 */
const resultBase = `/photos/uploaded?date=${date}&t=${ticket?.signedAt ?? 0}${
  returnTo ? `&return=${encodeURIComponent(returnTo)}` : ''
}`
---

<Base title="写真を追加" email={session?.email}>
  <div class="head">
    <h1>写真を追加</h1>
    <a href={returnTo ?? '/'}>{returnTo ? '編集へ戻る' : '一覧へ戻る'}</a>
  </div>

  {invalidDate && <p class="notice error">日付が不正だったので、今日の日付にした。</p>}

  <form method="get" action="/photos/new" class="date">
    <label>
      日付
      <input type="date" name="date" value={date} required />
    </label>
    {returnTo && <input type="hidden" name="return" value={returnTo} />}
    <button type="submit">この日付にする</button>
  </form>

  {
    ticketError ? (
      <p class="notice error">
        いま写真を追加できない（{ticketError}）。しばらくしてから試すこと。
      </p>
    ) : (
      ticket && (
        <>
          <noscript>
            <p class="notice error">
              写真の追加には JavaScript が必要。有効にして開き直すこと。
            </p>
          </noscript>

          <form
            id="upload"
            data-url={ticket.url}
            data-fields={JSON.stringify(ticket.fields)}
            data-max-bytes={String(MAX_UPLOAD_BYTES)}
            data-result={resultBase}
          >
            <label>
              写真
              <input type="file" name="file" accept="image/*" multiple required />
            </label>

            <div class="actions">
              <button type="submit" class="primary">追加する</button>
              <span id="progress" class="muted" />
            </div>

            <p id="failures" class="notice error" hidden />
          </form>
        </>
      )
    )
  }

  <p class="muted note">
    1枚あたり {maxMegabytes}MB まで。まとめて選べる。
  </p>

  <p class="muted note">
    <strong>HEIC には対応していない。</strong>
    iPhone で撮った写真は、設定を「互換性優先」にするか、JPEG で保存し直してから選ぶこと。
  </p>

  <script>
    /**
     * 元写真を S3 へ直接送る。
     *
     * **S3 の POST は1回に1枚しか受け取らない**ので、選ばれた枚数だけ要求を出す。
     * 署名は1枚ぶんで足りる（policy の条件は日付の接頭辞と大きさだけで、ファイル名を
     * 含まない）。
     *
     * 置かれたキーは応答の XML から読む。`${filename}` の置換は S3 が行うもので、
     * **その規則をこちら側に写さない**ため。
     */
    const form = document.querySelector<HTMLFormElement>('#upload')
    const file = form?.querySelector<HTMLInputElement>('input[type="file"]')
    const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]')
    const progress = document.querySelector<HTMLElement>('#progress')
    const failures = document.querySelector<HTMLElement>('#failures')

    if (form && file && button && progress && failures) {
      const url = form.dataset.url as string
      const fields = JSON.parse(form.dataset.fields as string) as Record<string, string>
      const maxBytes = Number(form.dataset.maxBytes)
      const result = form.dataset.result as string
      const limit = Math.floor(maxBytes / 1024 / 1024)

      /** 1枚送って、S3 が返したキーを取り出す。 */
      async function put(chosen: File): Promise<string> {
        const body = new FormData()
        // 署名済みのフィールドが先、file が最後。S3 はファイルより後ろを見ない。
        for (const [name, value] of Object.entries(fields)) body.append(name, value)
        body.append('file', chosen)

        const response = await fetch(url, { method: 'POST', body })
        const text = await response.text()

        if (!response.ok) {
          const message = /<Message>([^<]*)<\/Message>/.exec(text)?.[1]
          throw new Error(message ?? `${response.status}`)
        }

        const key = new DOMParser()
          .parseFromString(text, 'application/xml')
          .querySelector('Key')?.textContent
        if (!key) throw new Error('置かれた場所を読み取れなかった')
        return key
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault()

        const chosen = [...(file.files ?? [])]
        if (chosen.length === 0) return

        const tooBig = chosen.filter((f) => f.size > maxBytes)
        if (tooBig.length > 0) {
          failures.hidden = false
          failures.textContent = `${limit}MB を超えている: ${tooBig.map((f) => f.name).join('、')}`
          return
        }

        button.disabled = true
        file.disabled = true
        failures.hidden = true

        const keys: string[] = []
        const failed: string[] = []

        // **1枚の失敗が他の枚を巻き戻さない。** 送り終えたものはそのまま使える。
        for (const [index, one] of chosen.entries()) {
          progress.textContent = `${chosen.length} 枚中 ${index + 1} 枚目を送っている...`
          try {
            keys.push(await put(one))
          } catch (error) {
            failed.push(`${one.name}（${error instanceof Error ? error.message : error}）`)
          }
        }

        if (keys.length === 0) {
          button.disabled = false
          file.disabled = false
          progress.textContent = ''
          failures.hidden = false
          failures.textContent = `追加できなかった: ${failed.join('、')}`
          return
        }

        // 失敗したぶんは結果の画面へ持っていく。成功したものを見せないほうが困る。
        const query = keys.map((key) => `&key=${encodeURIComponent(key)}`).join('')
        const note = failed.length > 0 ? `&failed=${encodeURIComponent(failed.join('、'))}` : ''
        window.location.assign(`${result}${query}${note}`)
      })
    }
  </script>

  <style>
    .head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
    }

    .note {
      font-size: 0.9rem;
    }

    .notice {
      padding: 0.75rem 1rem;
      border: 1px solid var(--border);
      border-left: 3px solid var(--accent);
      border-radius: 4px;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin: 1.5rem 0 0.5rem;
    }

    form.date {
      flex-direction: row;
      align-items: end;
      gap: 0.75rem;
      margin-bottom: 0;
    }

    label {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      font-size: 0.9rem;
    }

    input[type='date'],
    input[type='file'] {
      padding: 0.4rem 0.5rem;
      border: 1px solid var(--border);
      border-radius: 4px;
      background: var(--bg);
      color: var(--fg);
      font: inherit;
    }

    .actions {
      display: flex;
      align-items: center;
      gap: 1rem;
      font-size: 0.9rem;
    }

    button {
      padding: 0.45rem 1.25rem;
      border: 1px solid var(--border);
      border-radius: 4px;
      background: none;
      color: var(--fg);
      font: inherit;
      cursor: pointer;
    }

    button.primary {
      border-color: var(--accent);
      color: var(--accent);
    }

    button:disabled {
      border-color: var(--border);
      color: var(--fg-muted);
      cursor: default;
    }
  </style>
</Base>
