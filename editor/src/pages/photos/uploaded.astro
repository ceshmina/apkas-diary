---
import { formatDateJa, isValidDate } from '../../../../src/lib/date.js'
import { photoUrl } from '../../../../src/lib/env.js'
import { PHOTO_SIZES, photoUrlOf } from '../../../../src/lib/photo.js'
import Base from '../../layouts/Base.astro'
import { acceptReturnedKey, probeDerivative, WAIT_TIMEOUT_MS } from '../../lib/photo-upload.js'

export const prerender = false

const session = Astro.locals.session

const params = Astro.url.searchParams
const date = params.get('date') ?? ''
const signedAt = Number(params.get('t'))

// 差し替えであることは、作り直しが終わると見えなくなる。読み直しをまたいで
// 持ち越すために query に載せている（`refreshTo`）。キーごとに持つ。
const knownReplaced = new Set(params.getAll('replaced'))

/** 投入そのものに失敗したぶん。送った側が持ってくる。 */
const failed = params.get('failed')

const rawReturn = params.get('return')
const returnTo = rawReturn?.startsWith('/entries/') ? rawReturn : undefined

// 受け取ってよいキーだけを通す。日付の下にあり、そこから先が単一のファイル名で
// あることまで見る。外れているものは黙って落とす。
const usable = isValidDate(date) && Number.isFinite(signedAt) && signedAt > 0
const keys = usable
  ? params
      .getAll('key')
      .map((key) => acceptReturnedKey(date, key))
      .filter((key): key is string => key !== undefined)
  : []

const base = keys.length > 0 ? photoUrl() : ''

interface Photo {
  key: string
  /** ファイル名だけ。画面に出すのはこちらで足りる。 */
  name: string
  ready: boolean
  replaced: boolean
  /** 本文に貼る記述。拡大表示が成り立つよう medium を使う。 */
  snippet: string
  thumbnail: string
  urls: { size: string; url: string }[]
  error?: string
}

const photos: Photo[] = await Promise.all(
  keys.map(async (key): Promise<Photo> => {
    const photo: Photo = {
      key,
      name: key.slice(key.lastIndexOf('/') + 1),
      ready: false,
      replaced: knownReplaced.has(key),
      snippet: `![](${photoUrlOf(base, 'medium', key)})`,
      thumbnail: photoUrlOf(base, 'thumbnail', key),
      urls: PHOTO_SIZES.map((size) => ({ size, url: photoUrlOf(base, size, key) })),
    }

    try {
      const probe = await probeDerivative(key, signedAt)
      photo.ready = probe.ready
      photo.replaced = photo.replaced || probe.replaced
    } catch (error) {
      photo.error = error instanceof Error ? error.message : String(error)
    }

    return photo
  }),
)

const pending = photos.filter((p) => !p.ready && !p.error)

// 待ちきれなかった状態。**失敗ではない。** 遅れているのか、そもそも読めない形式
// だったのかは、ここからは区別できない。
const gaveUp = Date.now() - signedAt > WAIT_TIMEOUT_MS

/**
 * まだのものがあるあいだだけ読み直す。
 *
 * 読み直す先に `replaced` を足すのは、作り直しが終わったあとにはもう「前のものが
 * あった」と判定できないため。見えたときに拾って次の要求へ渡す。
 */
let refreshTo: string | undefined
if (pending.length > 0 && !gaveUp) {
  const next = new URL(Astro.url)
  next.searchParams.delete('replaced')
  for (const photo of photos) {
    if (photo.replaced) next.searchParams.append('replaced', photo.key)
  }
  refreshTo = `${next.pathname}${next.search}`
}

const heading = keys.length === 0 ? '結果を表示できない' : '追加した写真'
---

<Base
  title={heading}
  email={session?.email}
  refreshSeconds={refreshTo ? 3 : undefined}
  refreshTo={refreshTo}
>
  <div class="head">
    <h1>{heading}</h1>
    <a href={returnTo ?? '/'}>{returnTo ? '編集へ戻る' : '一覧へ戻る'}</a>
  </div>

  {failed && <p class="notice error">追加できなかった写真がある: {failed}</p>}

  {
    keys.length === 0 ? (
      <>
        <p class="notice error">追加の結果を確かめられなかった。</p>
        <p>
          <a href="/photos/new">やり直す</a>
        </p>
      </>
    ) : (
      <>
        <p class="muted lead">
          <time datetime={date}>{formatDateJa(date)}</time> に {photos.length} 枚追加した。
          {pending.length > 0 && !gaveUp && (
            <span> 残り {pending.length} 枚を準備している。</span>
          )}
        </p>

        {pending.length > 0 && gaveUp && (
          <p class="notice error">
            <strong>まだ準備できない写真がある。</strong>
            時間がかかっているか、画像として読めなかった可能性がある。
            HEIC の場合は JPEG で保存し直して追加すること。
          </p>
        )}

        <ul class="photos">
          {photos.map((photo) => (
            <li>
              <div class="figure">
                {/*
                  **生成が終わったものだけを出す。** まだ無いうちに img を置くと、
                  ブラウザが配信 URL を取りにいき、まだ無いあいだの 403 が CDN に
                  載る（decision 4 で避けたことを、確認の表示のほうから起こして
                  しまう）。順序を入れ替えないこと。
                */}
                {photo.ready ? (
                  <a href={photo.urls[3]?.url} target="_blank" rel="noreferrer noopener">
                    <img src={photo.thumbnail} alt={photo.name} loading="lazy" />
                  </a>
                ) : (
                  <span class="placeholder muted">{photo.error ? '確認できず' : '準備中'}</span>
                )}
              </div>

              <div class="body">
                <p class="name">
                  {photo.name}
                  {photo.replaced && <span class="pill tag">差し替え</span>}
                </p>

                {photo.error ? (
                  <p class="muted small">
                    準備できたかを確認できなかった（{photo.error}）。追加そのものは成功している。
                  </p>
                ) : !photo.ready ? (
                  <p class="muted small">準備できるまで、この写真はまだ表示できない。</p>
                ) : (
                  <>
                    <input class="snippet" type="text" value={photo.snippet} readonly />
                    <details>
                      <summary class="muted small">ほかのサイズ</summary>
                      <ul class="urls">
                        {photo.urls.map(({ size, url }) => (
                          <li>
                            <span class="size muted">{size}</span>
                            <a href={url} target="_blank" rel="noreferrer noopener">
                              {url}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </details>
                  </>
                )}
              </div>
            </li>
          ))}
        </ul>

        <p class="muted note">
          本文に貼るとその写真が表示される。<code>[]</code> の中に書いた文は写真の下に出る。
        </p>

        <p class="actions">
          <a
            href={`/photos/new?date=${date}${returnTo ? `&return=${encodeURIComponent(returnTo)}` : ''}`}
          >
            さらに追加する
          </a>
        </p>
      </>
    )
  }

  <style>
    .small {
      margin: 0;
      font-size: 0.9rem;
    }

    .photos {
      margin: 1.5rem 0;
      padding: 0;
      list-style: none;
    }

    .photos > li {
      display: flex;
      gap: 1rem;
      padding: 1rem 0;
      border-top: 1px solid var(--border);
    }

    .figure {
      flex: none;
      width: 120px;
    }

    .figure img {
      display: block;
      width: 100%;
      height: auto;
      border-radius: var(--radius-sm);
    }

    .placeholder {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 90px;
      border: 1px dashed var(--border);
      border-radius: var(--radius-sm);
      font-size: 0.8rem;
    }

    .body {
      flex: 1;
      min-width: 0;
    }

    .name {
      margin: 0 0 0.5rem;
      font-size: 0.9rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .tag {
      margin-left: 0.5rem;
    }

    /* 本文に貼る記述。読むのではなく写すものなので等幅にする。 */
    .snippet {
      width: 100%;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.85rem;
    }

    details {
      margin-top: 0.5rem;
    }

    summary {
      cursor: pointer;
    }

    .urls {
      margin: 0.5rem 0 0;
      padding: 0;
      list-style: none;
      font-size: 0.8rem;
    }

    .urls li {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      padding: 0.2rem 0;
      min-width: 0;
    }

    .size {
      flex: none;
      width: 5rem;
    }

    .urls a {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .actions {
      font-size: 0.9rem;
    }
  </style>
</Base>
