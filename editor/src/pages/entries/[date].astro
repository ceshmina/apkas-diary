---
import { formatDateJa, isValidDate } from '../../../../src/lib/date.js'
import { renderMarkdown } from '../../../../src/lib/markdown.js'
import { isEntryStatus } from '../../../../src/lib/store/entry.js'
import { putEntry } from '../../../../src/lib/store/put.js'
import { getEntry } from '../../../../src/lib/store/queries.js'
import Base from '../../layouts/Base.astro'

export const prerender = false

const date = Astro.params.date ?? ''

// 日付として読めないものは、存在しないページとして扱う。
if (!isValidDate(date)) {
  Astro.response.status = 404
}

const existing = isValidDate(date) ? await getEntry(date) : undefined

let title = existing?.title ?? ''
let body = existing?.body ?? ''
let status = existing?.status ?? 'draft'

let preview: string | undefined
let error: string | undefined
const saved = Astro.url.searchParams.has('saved')

if (isValidDate(date) && Astro.request.method === 'POST') {
  const form = await Astro.request.formData()

  // 保存に失敗しても入力を捨てない。以降の描画はフォームから読んだ値で行う。
  title = String(form.get('title') ?? '')
  body = String(form.get('body') ?? '')
  const rawStatus = String(form.get('status') ?? '')
  status = isEntryStatus(rawStatus) ? rawStatus : 'draft'

  const action = String(form.get('action') ?? 'save')

  if (action === 'preview') {
    preview = await renderMarkdown(body)
  } else {
    try {
      // 書き込みは CLI と同じ経路を通す。GSI キー属性の付け外しも作成日時の
      // 引き継ぎも putEntry が持っており、ここでは持たない。
      await putEntry({ date, title, body, status })

      // POST の結果をそのまま描画すると、再読み込みで二重に保存される。
      //
      // 写真の投入はこの画面を離れる（フォームが S3 へ POST するため、書きかけの
      // 本文を抱えたまま行けない）。**保存を経てから移る**ことで、戻ったときに
      // 入力が残っている。保存を伴うことはボタンの文言で分かるようにしてある。
      if (action === 'photo') {
        const target = new URL('/photos/new', Astro.url)
        target.searchParams.set('date', date)
        target.searchParams.set('return', `/entries/${date}`)
        return Astro.redirect(`${target.pathname}${target.search}`, 303)
      }

      return Astro.redirect(`/entries/${date}?saved=1`, 303)
    } catch (e) {
      // 保存に失敗したら移らない。入力を抱えたままこの画面に留まる。
      error = e instanceof Error ? e.message : String(e)
    }
  }
}

const session = Astro.locals.session
const heading = isValidDate(date) ? formatDateJa(date) : '日付が不正です'
---

<Base title={heading} email={session?.email}>
  {
    !isValidDate(date) ? (
      <>
        <h1>日付が不正です</h1>
        <p class="muted">YYYY-MM-DD 形式の、実在する日付を指定してください。</p>
        <p>
          <a href="/entries/new">日付を選び直す</a>
        </p>
      </>
    ) : (
      <>
        <div class="head">
          <h1>
            <time datetime={date}>{heading}</time>
          </h1>
          <span class="state muted">
            {existing ? `更新 ${existing.updatedAt}` : '新規'}
          </span>
        </div>

        {saved && <p class="notice ok">保存しました。</p>}
        {error && (
          <p class="notice error">
            保存できませんでした（{error}）。入力はそのまま残っているので、もう一度お試しください。
          </p>
        )}

        <form method="post">
          <label>
            タイトル
            <input type="text" name="title" value={title} autocomplete="off" />
          </label>

          <label>
            本文（Markdown）
            <textarea name="body" rows="20">{body}</textarea>
          </label>

          <fieldset>
            <legend>公開状態</legend>
            <label class="radio">
              <input type="radio" name="status" value="draft" checked={status === 'draft'} />
              下書き
            </label>
            <label class="radio">
              <input type="radio" name="status" value="published" checked={status === 'published'} />
              公開
            </label>
            <p class="muted hint">
              公開にすると、次のサイト生成から公開サイトに現れる。下書きに戻すと消える。
              保存しただけでは反映されない。<a href="/publish">公開</a>から反映する。
            </p>
          </fieldset>

          <div class="actions">
            <button type="submit" name="action" value="save" class="primary">保存</button>
            <button type="submit" name="action" value="preview">表示を確認</button>
            {/*
              写真の投入はこの画面を離れるので、先に保存する。**押す前にそれが
              分かるよう、文言に書いてある**（entry-editing の「保存が起きること
              の明示」）。
            */}
            <button type="submit" name="action" value="photo">保存して写真を追加</button>
            <a href="/">一覧へ戻る</a>
          </div>
        </form>

        {
          preview !== undefined && (
            <section class="preview">
              <h2 class="section-title">表示の確認</h2>
              <p class="muted">
                公開サイトと同じ整形で表示している。まだ保存されていない。
              </p>
              <article set:html={preview} />
            </section>
          )
        }
      </>
    )
  }

  <style>
    .head h1 {
      margin-bottom: 0.5rem;
    }

    .state {
      flex: none;
      font-size: 0.8rem;
      font-variant-numeric: tabular-nums;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    /* 公開状態の選択。入力欄の見出しと違い、印と語が横に並ぶ。 */
    .radio {
      flex-direction: row;
      align-items: center;
      gap: 0.4rem;
      font-size: 1rem;
    }

    .hint {
      margin-bottom: 0;
      font-size: 0.85rem;
    }

    .preview {
      margin-top: 3rem;
    }
  </style>
</Base>
