---
import { formatDateJa, todayJst, yearOf } from '../../../src/lib/date.js'
import { byDateDesc } from '../../../src/lib/store/entry.js'
import { scanAllIncludingDrafts } from '../../../src/lib/store/queries.js'
import Base from '../layouts/Base.astro'

export const prerender = false

// 一覧には下書きも出す。公開サイトと違い、ここは書き手が見る場所である。
// GSI1 は下書きを載せないため、ベーステーブルを走査して取る。
const all = (await scanAllIncludingDrafts()).sort(byDateDesc)

// 年ごとの件数は走査済みの結果から数える。追加の読み取りは要らない。
const years = new Map<string, number>()
for (const entry of all) {
  const year = yearOf(entry.date)
  years.set(year, (years.get(year) ?? 0) + 1)
}

const selectedYear = Astro.url.searchParams.get('year')
const filtered = selectedYear ? all.filter((e) => yearOf(e.date) === selectedYear) : all

// 全件を1ページに並べると、年を重ねるほど読み込みが重くなる。既定では
// 直近だけを見せ、それより古いものは年で辿らせる。
const LIMIT = 100
const truncated = !selectedYear && filtered.length > LIMIT
const shown = truncated ? filtered.slice(0, LIMIT) : filtered

const session = Astro.locals.session
const heading = selectedYear ? `${selectedYear}年のエントリ` : 'エントリ'
---

<Base title={heading} email={session?.email}>
  <div class="head">
    <h1>{heading}</h1>
    <span class="head-actions">
      {/*
        公開サイトへ反映する入口。**「未反映のものがある」とは示さない。**
        それを言うには最後の反映より後に書かれたかを判定する必要があり、
        判定の根拠を持たないまま示すと嘘になる。状況は /publish で見る。
      */}
      <a href="/publish">公開</a>
      {/*
        エントリを書かずに写真だけ入れたいときの入口。書きながら入れる場合は
        編集画面の「保存して写真を追加」から入る（そちらは日付が決まっている）。
      */}
      <a href="/photos/new">写真</a>
      <a href="/entries/new">別の日</a>
      <a class="button primary" href={`/entries/${todayJst()}`}>今日の日記を書く</a>
    </span>
  </div>

  {
    all.length === 0 ? (
      <p class="empty">
        まだエントリがありません。
        <a href={`/entries/${todayJst()}`}>最初の1件を書く</a>。
      </p>
    ) : (
      <>
        <p class="muted">
          {selectedYear ? `${filtered.length} 件` : `全 ${all.length} 件`}
          {truncated && ` のうち新しい ${shown.length} 件`}
        </p>

        <ul class="entries">
          {shown.map((entry) => (
            <li>
              <a href={`/entries/${entry.date}`}>
                <time datetime={entry.date}>{formatDateJa(entry.date)}</time>
                <span class="title">{entry.title || <span class="muted">（無題）</span>}</span>
              </a>
              <span class={`pill status ${entry.status === 'published' ? '' : 'is-quiet'}`}>
                {entry.status === 'published' ? '公開' : '下書き'}
              </span>
            </li>
          ))}
        </ul>

        {/* いま見ている年だけがアクセント色のピルになる。他は地を持たない側。 */}
        <nav class="years">
          {selectedYear && (
            <a class="pill is-quiet" href="/">
              すべて
            </a>
          )}
          {[...years.entries()]
            .sort(([a], [b]) => (a < b ? 1 : -1))
            .map(([year, count]) => (
              <a
                class={`pill ${year === selectedYear ? '' : 'is-quiet'}`}
                href={`/?year=${year}`}
                aria-current={year === selectedYear ? 'page' : undefined}
              >
                {year}
                <span class="count"> ({count})</span>
              </a>
            ))}
        </nav>
      </>
    )
  }

  <style>
    .head-actions {
      display: flex;
      flex: none;
      align-items: baseline;
      gap: 1rem;
      font-size: 0.9rem;
    }

    .head-actions .button {
      flex: none;
    }

    .empty {
      padding: 2rem 0;
    }

    .entries {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .entries li {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--border);
    }

    .entries a {
      display: flex;
      flex: 1;
      align-items: baseline;
      gap: 0.75rem;
      min-width: 0;
      text-decoration: none;
    }

    .entries time {
      flex: none;
      color: var(--fg-muted);
      font-size: 0.85rem;
      font-variant-numeric: tabular-nums;
    }

    .entries .title {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .status {
      flex: none;
    }

    .years {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      padding-top: 1.5rem;
    }

    /* 年に添える件数。ピルの中では控えめに置く。 */
    .count {
      opacity: 0.7;
    }
  </style>
</Base>
