---
import { type DiaryFont, FONTS } from '../../../src/styles/fonts.js'
// 配色と本文要素は公開サイトと共有する。プレビューの見え方を公開後と
// 揃えるための前提であり、ここで上書きしない。
import '../../../src/styles/tokens.css'
import '../../../src/styles/base.css'

interface Props {
  title: string
  /** ログイン中の利用者。未認証の画面（ログイン）では渡さない。 */
  email?: string
  /**
   * 指定すると、その秒数後にページを読み直す。
   *
   * 進行中の公開手続きや、生成を待っている写真を見ているときだけ使う。数秒に
   * 一度しか変わらないものに常時接続の仕組みを持ち込まないための、いちばん軽い
   * 手段。終わった状態を表示しているあいだは指定しないこと（読み直しても何も
   * 変わらない）。
   */
  refreshSeconds?: number
  /**
   * 読み直す先。省略すると同じ URL を読み直す。
   *
   * 読み直すたびに失われてしまう事実を、次の要求へ持ち越すために使う。写真の
   * 差し替えの判定がこれにあたる（作り直しが終わると「前のものがあった」ことは
   * もう見えない）。
   */
  refreshTo?: string
  /**
   * 紙面を広く取る。
   *
   * 既定は公開サイトと同じ `--page`（40rem）である。**広げるのは、2つのものを
   * 横に並べる画面だけ**にする。記事の編集画面が入力とプレビューを左右に並べる
   * ためにこれを使う（`entry-editing`）。40rem のまま2列に割ると1列 19rem ほどに
   * なり、書くにも読むにも足りない。
   *
   * 画面ごとに明示して渡す形にしてあるのは、広さが意図せず他の画面へ広がらない
   * ようにするため。一覧・公開・写真は 40rem のままでよい。
   */
  wide?: boolean
}

const { title, email, refreshSeconds, refreshTo, wide } = Astro.props
const appTitle = 'apkas-diary 編集'
const fullTitle = title === appTitle ? appTitle : `${title} | ${appTitle}`

/*
 * 書体。公開サイトと同じ一覧（src/styles/fonts.ts）から、Google Fonts の URL と
 * 書体の変数を作る。どの書体をどの太さで使うかは、一覧を変えれば両方に効く。
 *
 * 公開サイトと違って自分では配らない。配ると書体のファイル（数 MB）が Lambda の
 * 配布物に入り、直接アップロードの上限（50 MB）に近づく。利用者は書き手だけで、
 * 第三者の書体配信へ要求が出ることを避ける理由もない。
 *
 * 取得元は公開サイトのビルドと同じ Google Fonts で、問い合わせの形（`ital,wght`）
 * も同じにしてある。プレビューと公開後で書体の版がずれるのは、Google で版が
 * 更新されてから次に公開するまでのあいだに限られる。
 */
function familyQuery({ name, weights, styles }: DiaryFont): string {
  const variants = styles
    .flatMap((style) => weights.map((weight) => [style === 'italic' ? 1 : 0, weight] as const))
    .sort(([italA, weightA], [italB, weightB]) => italA - italB || weightA - weightB)
    .map(([ital, weight]) => `${ital},${weight}`)
  return `family=${name.replaceAll(' ', '+')}:ital,wght@${variants.join(';')}`
}

const fontsHref = `https://fonts.googleapis.com/css2?${FONTS.map(familyQuery).join('&')}&display=swap`

// 総称の書体名は引用符で囲むと効かなくなる（その名前の書体を探しにいく）。
const GENERIC_FAMILIES = new Set(['serif', 'sans-serif', 'monospace', 'system-ui'])

const fontVariables = `:root{${FONTS.map(
  ({ name, cssVariable, fallbacks }) =>
    `${cssVariable}:${[name, ...fallbacks]
      .map((family) => (GENERIC_FAMILIES.has(family) ? family : `"${family}"`))
      .join(',')};`,
).join('')}}`
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="robots" content="noindex, nofollow" />
    {/*
     * ブラウザの枠の色。値は tokens.css の --bg と同じで、公開サイトとも揃う。
     * 配色は白い地の1通りなので、明暗の設定で分けない。
     */}
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} />
    <style is:inline set:html={fontVariables}></style>
    {
      refreshSeconds && (
        <meta
          http-equiv="refresh"
          content={refreshTo ? `${refreshSeconds}; url=${refreshTo}` : String(refreshSeconds)}
        />
      )
    }
    <link rel="icon" href="data:," />
  </head>
  <body class={wide ? 'wide' : undefined}>
    <header>
      <a href="/" class="app-title">{appTitle}</a>
      {
        email && (
          <span class="session">
            <span class="muted">{email}</span>
            <form method="post" action="/auth/logout">
              <button type="submit" class="link">ログアウト</button>
            </form>
          </span>
        )
      }
    </header>

    <main>
      <slot />
    </main>

    <style is:global>
      /*
       * 編集アプリケーションの骨格と、画面をまたいで現れる部品。配色・書体・
       * 角丸の基準と、本文要素・ピルの体裁は src/styles/ にあり、公開サイトと
       * 共有している。
       *
       * 部品（囲み・ボタン・入力欄）をここに置くのは、同じ CSS が各ページの
       * `<style>` に書き写されていたため。ページ側には、その画面にしかない
       * 配置だけを残す。
       */
      header,
      main {
        max-width: var(--page);
        margin: 0 auto;
      }

      /*
       * 広い紙面（`wide`）。値は 40rem の紙面を2列に割っても読み書きに耐える幅
       * として置いている。`--page` を書き換えないのは、あれが公開サイトと共有して
       * いる本文の幅であり、編集の都合で動かすものではないため。
       *
       * 題と本体で幅が違うと、画面の中に段差が出る。header にも同じだけ効かせる。
       */
      .wide header,
      .wide main {
        max-width: 64rem;
      }

      /* 題の下に強い罫線を引く。公開サイトのヘッダーと同じ。 */
      header {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.5rem 1rem;
        padding: 1.7rem 0 0.75rem;
        border-bottom: 1px solid var(--fg);
      }

      /*
       * 題。公開サイトの題字（`.site-title`）と同じ字面で、朱の小さな丸を添える。
       * 「編集」は題字の書体に無い字なので、その後ろに続く和文の明朝で出る
       * （tokens.css の --font-display）。
       */
      .app-title {
        color: var(--fg);
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 1.95rem;
        line-height: 1;
        letter-spacing: -0.005em;
        text-decoration: none;
      }

      .app-title::after {
        content: '';
        display: inline-block;
        width: 0.3rem;
        height: 0.3rem;
        margin-left: 0.12rem;
        border-radius: 50%;
        background: var(--accent);
      }

      .session {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
        font-size: 0.85rem;
      }

      .session form {
        display: inline;
      }

      main {
        padding: 2rem 0 4rem;
        min-height: 60vh;
      }

      /* 見出しと本文のあいだに置く一言。 */
      .lead,
      .note {
        font-size: 0.9rem;
      }

      /*
       * 伝えることのある囲み（保存した、失敗した、確認する）。囲むものの形なので
       * 角を立てる。左の線で種類を示し、失敗を伝えるものだけを朱にする。誤りに
       * 印を付ける「朱を入れる」の朱で、ほかの囲みの線は黒にする。
       */
      .notice {
        padding: 0.75rem 1rem;
        border: 1px solid var(--border);
        border-left: 3px solid var(--fg);
        border-radius: var(--radius);
        background: var(--surface);
      }

      .notice.error {
        border-left-color: var(--accent);
      }

      /* 押す前に一段構える囲み。全体を黒で縁取る。 */
      .confirm {
        padding: 1rem 1.25rem;
        border: 1px solid var(--fg);
        border-radius: var(--radius);
        background: var(--surface);
      }

      /*
       * ボタン。押せるものの形なので丸くし、白地に黒の細い枠で示す。`.primary` は
       * その画面で主となる操作で、黒で塗って白抜きにする。
       *
       * ホバーでは枠と字が朱になる。`.primary` は塗りを変えず、朱の輪を出す。朱で
       * 面を塗らず（tokens.css）、黒の上の字を朱にもしない（読むに足るコントラスト
       * を持たない）。押す位置が動かないよう、浮き上がりは付けない。
       */
      button,
      .button {
        display: inline-block;
        padding: 0.45rem 1.25rem;
        border: 1px solid var(--fg);
        border-radius: var(--radius-pill);
        background: var(--surface);
        color: var(--fg);
        font: inherit;
        line-height: 1.5;
        text-decoration: none;
        cursor: pointer;
        transition:
          color 0.18s ease,
          border-color 0.18s ease,
          box-shadow 0.18s ease;
      }

      button.primary,
      .button.primary {
        background: var(--fg);
        color: var(--bg);
      }

      button:hover:not(:disabled),
      .button:hover {
        border-color: var(--accent);
        color: var(--accent);
      }

      button.primary:hover:not(:disabled),
      .button.primary:hover {
        border-color: var(--fg);
        color: var(--bg);
        box-shadow:
          0 0 0 2px var(--bg),
          0 0 0 3px var(--accent);
      }

      button:disabled {
        border-color: var(--border);
        background: var(--surface);
        color: var(--fg-muted);
        cursor: default;
      }

      /*
       * 見た目はリンク、実体はボタン。副作用のある操作を GET にしないため。字面は
       * リンク（base.css）と同じにする。
       */
      button.link {
        padding: 0;
        border: 0;
        border-radius: 0;
        background: none;
        color: var(--fg);
        font: inherit;
        font-size: inherit;
        text-decoration-line: underline;
        text-decoration-thickness: 1px;
        text-decoration-color: var(--fg-muted);
        text-underline-offset: 0.3em;
        cursor: pointer;
      }

      button.link:hover {
        color: var(--accent);
        text-decoration-color: var(--accent);
      }

      /*
       * 入力欄。囲むものの形なので角を立てる。枠は淡い文字の色にする。罫線の色では
       * 地とのあいだのコントラストが足りず、入力できる場所が見えにくい（tokens.css）。
       */
      input[type='text'],
      input[type='date'],
      input[type='file'],
      textarea {
        padding: 0.45rem 0.5rem;
        border: 1px solid var(--fg-muted);
        border-radius: var(--radius);
        background: var(--surface);
        color: var(--fg);
        font: inherit;
      }

      textarea {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.95rem;
        line-height: 1.7;
        resize: vertical;
      }

      /*
       * ファイル選択の中のボタン。ブラウザ既定の灰色のままだと、ここだけ浮く。
       * ほかのボタンと同じ形と手応えにする。
       */
      input[type='file']::file-selector-button {
        margin-right: 0.75rem;
        padding: 0.25rem 0.9rem;
        border: 1px solid var(--fg);
        border-radius: var(--radius-pill);
        background: var(--surface);
        color: var(--fg);
        font: inherit;
        font-size: 0.9rem;
        cursor: pointer;
        transition:
          color 0.18s ease,
          border-color 0.18s ease;
      }

      input[type='file']:not(:disabled)::file-selector-button:hover {
        border-color: var(--accent);
        color: var(--accent);
      }

      input[type='file']:disabled::file-selector-button {
        border-color: var(--border);
        color: var(--fg-muted);
        cursor: default;
      }

      /* 入力欄の見出し。入力そのものの上に小さく置く。 */
      label {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        font-size: 0.9rem;
      }

      fieldset {
        margin: 0;
        padding: 0.75rem 1.25rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--surface);
      }

      legend {
        padding: 0 0.4rem;
        font-size: 0.9rem;
      }

      /* 操作の並び。ボタンとリンクを横に並べる。 */
      .actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem;
      }

      /*
       * 画面の題と、その右に置く小さな操作。狭い画面では操作のほうが下へ回る。
       * 折り返さないと、題が1文字ずつの縦棒になるまで潰れる。
       */
      .head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.5rem 1rem;
      }
    </style>
  </body>
</html>
