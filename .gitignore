.DS_Store

# Claude Code のローカル設定（権限の承認記録などが入る）
.claude/settings.local.json

# Node.js
node_modules/

# Astro のビルド生成物
dist/
.astro/

# 日記本文の書き出し先。バックアップ目的でありコミットしない
# （design.md 決定12。CI 移行時は GitHub Release へ載せる）
# 先頭のスラッシュは必須。付けないと src/export/ にも一致し、
# 書き出しの実装そのものがコミットから漏れる。
/export/

# 写真の移行の作業場所。台帳・集めた元写真・書き換え前の本文の控えが入る。
# 日記の本文そのものを含むうえ、元写真は数 GB になる
/migration/

# 環境ごとの設定。実値はコミットしない
# （`.env.<環境>` にしないのは Vite が自動ロードしてしまうため。load-env.sh 参照）
config/*.env
!config/*.env.example
.env
.env.*

# Lambda の配布物。lambroll deploy のたびに作り直す
lambda/*/build/
editor/build/

# Terraform
**/.terraform/
# Terraform が組み立てる placeholder の zip。中身はインラインで定義してある
**/placeholder.zip
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# backend.hcl はバケット名にアカウント ID を含むため除外する
backend.hcl
!backend.hcl.example
crash.log
crash.*.log
