---
import EntryList from '../../components/EntryList.astro'
import Base from '../../layouts/Base.astro'
import { allMonthDays, formatMonthDayJa } from '../../lib/date.js'
import { byDateDesc, entriesByMonthDay } from '../../lib/site-data.js'
import type { Entry } from '../../lib/store/entry.js'

/**
 * 閏日を含む366通りの月日すべてについてページを生成する。
 *
 * 月日はどれも URL で直接指し示せるようにしておきたいので、エントリのある月日
 * に絞らず全通りを用意する。閏日の扱いを含め、生成の条件分けが増えない。
 *
 * 該当するエントリがない月日でも 404 にはせず、ページを出す。
 */
export async function getStaticPaths() {
  const grouped = await entriesByMonthDay()

  return allMonthDays().map((monthDay) => ({
    params: { monthday: monthDay },
    props: {
      entries: [...(grouped.get(monthDay) ?? [])].sort(byDateDesc),
    },
  }))
}

const { monthday } = Astro.params
const { entries } = Astro.props as { entries: Entry[] }
const label = formatMonthDayJa(monthday ?? '01-01')
---

<Base title={`${label}の記録`}>
  <h1>{label}の記録</h1>

  <EntryList
    entries={entries}
    emptyMessage={`${label}の日記はまだありません。`}
  />
</Base>
