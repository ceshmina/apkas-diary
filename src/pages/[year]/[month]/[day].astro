---
import Base from '../../../layouts/Base.astro'
import { dayOf, formatDateJa, monthDayOf, monthOf, yearOf } from '../../../lib/date.js'
import { renderMarkdown } from '../../../lib/markdown.js'
import { publishedEntries } from '../../../lib/site-data.js'
import type { Entry } from '../../../lib/store/entry.js'

// 入力は公開済みエントリのみ。下書きの日付はパスとして生成されないため、
// アクセスすると 404 になり、下書きの存在も判別できない。
export async function getStaticPaths() {
  const entries = await publishedEntries()

  return entries.map((entry) => ({
    params: {
      year: yearOf(entry.date),
      month: monthOf(entry.date),
      day: dayOf(entry.date),
    },
    props: { entry },
  }))
}

const { entry } = Astro.props as { entry: Entry }
const html = await renderMarkdown(entry.body)
const monthDay = monthDayOf(entry.date)
const dateJa = formatDateJa(entry.date)

// 日記に名前を付けない日のほうが多い。タイトルの不在は欠落ではないので、
// 「(無題)」のような文言では示さず、日付そのものを見出しにする。
//
// 日付を出す場所はタイトルの有無で排他になる（見出しか、その上の日付行か）。
// 同じ日付が1ページに2度現れないため、書式を変えて見分けさせる必要がない。
// タイトルの有無によらず `formatDateJa` の1つの書式で通す。
---

<Base title={entry.title || dateJa}>
  <article>
    {
      entry.title && (
        <p class="date">
          <time datetime={entry.date}>{dateJa}</time>
        </p>
      )
    }
    <h1>
      {entry.title || <time datetime={entry.date}>{dateJa}</time>}
    </h1>

    <div class="body" set:html={html} />
  </article>

  <nav class="links">
    <a href={`/${yearOf(entry.date)}/${monthOf(entry.date)}`}>
      {Number(monthOf(entry.date))}月の一覧
    </a>
    <a href={`/${yearOf(entry.date)}`}>{yearOf(entry.date)}年の一覧</a>
    <a href={`/on-this-day/${monthDay}`}>過去の同じ日</a>
  </nav>
</Base>

<style>
  .date {
    margin: 0 0 0.25rem;
    color: var(--fg-muted);
    font-size: 0.9rem;
  }

  h1 {
    margin-bottom: 2rem;
  }

  .body {
    /* 並べた画像どうしの間隔。表の外周にも同じだけ空くので、負のマージンで打ち消す。 */
    --grid-gap: 0.4rem;
  }

  .body :global(> :first-child) {
    margin-top: 0;
  }

  /* 本文中の `---`。前後の段落と紛れないよう、既定よりも広く空ける。 */
  .body :global(hr) {
    margin: 3rem 0;
  }

  /*
   * 本文中に直接書かれた画像の並び。
   *
   * 旧サイトから引き継いだ記事は、画像を横に並べるために `table` を本文に直接
   * 書いている。Markdown では表せない配置のための記述であり、表ではない。
   *
   * `table-layout: fixed` にするのは列幅を等分するため。既定の自動レイアウトでは
   * 画像の実寸の比で列幅が決まり、並べた画像の大きさが揃わない。
   */
  .body :global(table) {
    width: calc(100% + 2 * var(--grid-gap));
    margin: calc(2rem - var(--grid-gap)) calc(-1 * var(--grid-gap));
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: var(--grid-gap);
  }

  .body :global(td) {
    padding: 0;
    vertical-align: top;
  }

  .body :global(td img) {
    display: block;
  }

  .body :global(figure) {
    margin: 2rem 0;
  }

  .body :global(figure img) {
    display: block;
  }

  /*
   * 画像に添えられた説明。
   *
   * `figcaption` は画像1枚に対する説明、行全体に及ぶセルは並び全体に対する説明で、
   * 読み手にとっては同じものなので体裁を揃える。画像の入るセルに `colspan` が
   * 付くことはないため、`td[colspan]` で説明の行だけを選べる。
   */
  .body :global(figcaption),
  .body :global(td[colspan]) {
    padding-top: 0.35rem;
    color: var(--fg-muted);
    font-size: 0.85rem;
    line-height: 1.6;
    text-align: center;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }
</style>
