---
import DateBlock from '../../../components/DateBlock.astro'
import ListLinks from '../../../components/ListLinks.astro'
import PhotoZoom from '../../../components/PhotoZoom.astro'
import Base from '../../../layouts/Base.astro'
import {
  dayOf,
  formatDateEn,
  formatDateJa,
  monthAbbrOf,
  monthDayOf,
  monthOf,
  yearOf,
} from '../../../lib/date.js'
import { renderMarkdown } from '../../../lib/markdown.js'
import { type EntryLink, entriesWithNeighbors, photoEquipment } from '../../../lib/site-data.js'
import type { Entry } from '../../../lib/store/entry.js'

// 入力は公開済みエントリのみ。下書きの日付はパスとして生成されないため、
// アクセスすると 404 になり、下書きの存在も判別できない。
//
// 両隣も同じ入力から解決される。下書きは隣として現れず、飛ばされたことも
// 外からは分からない。
export async function getStaticPaths() {
  const entries = await entriesWithNeighbors()

  return entries.map(({ entry, newer, older }) => ({
    params: {
      year: yearOf(entry.date),
      month: monthOf(entry.date),
      day: dayOf(entry.date),
    },
    props: { entry, newer, older },
  }))
}

const { entry, newer, older } = Astro.props as {
  entry: Entry
  newer?: EntryLink
  older?: EntryLink
}
// 本文の写真に、その写真の撮影機材を `data-equipment` として載せる。引き当ては
// ビルド中に1度だけ作られ、すべての日別ページが同じものを見る。記録のない写真には
// 属性が付かないので、拡大表示にも何も出ない。
const html = await renderMarkdown(entry.body, await photoEquipment())
const monthDay = monthDayOf(entry.date)
const dateJa = formatDateJa(entry.date)
const year = yearOf(entry.date)
const month = monthOf(entry.date)

function hrefOf(date: string): string {
  return `/${yearOf(date)}/${monthOf(date)}/${dayOf(date)}`
}

// 日記に名前を付けない日のほうが多い。タイトルの不在は欠落ではないので、
// 「(無題)」のような文言では示さず、日付そのものを見出しにする。
//
// 日付を出す場所はタイトルの有無で排他になる（見出しそのものか、その上か）。
// 同じ日付が1ページに2度現れないため、形を変えて見分けさせる必要がない。
// タイトルの有無によらず、日付の部品（DateBlock）の1つの形・1つの大きさで通す。
// 文書の題（`<title>`）は、読み上げと検索に使われる文字なので和文のままにする。
//
// 場所は**この分岐の中に入れない**。頭のまとまり（.entry-head）の最後に、独立した
// 1行として置く。分岐の中に入れると、2つの形それぞれに場所のありなしが掛かって
// 4通りになる。外に出せば、タイトルの有無によらず同じ位置・同じ字面で出る。
//
// 場所を持たない日は行そのものを出さない。タイトルの不在と同じ扱いで、欠落として
// 示さない。日記の大半は場所を伴わない。
---

<Base title={entry.title || dateJa}>
  <article>
    <header class="entry-head">
      {
        entry.title ? (
          <>
            <p class="dateline">
              <DateBlock date={entry.date} mark />
            </p>
            <h1>{entry.title}</h1>
          </>
        ) : (
          <h1>
            <DateBlock date={entry.date} mark />
          </h1>
        )
      }

      {entry.location && <p class="location">{entry.location}</p>}
    </header>

    <div class="body prose" set:html={html} />
  </article>

  {/*
   * 前後の導線。左が新しい日付、右が古い日付を指す。一覧が新しい順に並ぶのと
   * 同じ向きで、一覧を下へ読むことと右を辿ることが、どちらも過去へ遡る動きになる。
   *
   * 隣が存在しない側は要素ごと出さない。タイトルのないエントリに「(無題)」と書かない
   * のと同じで、そこに何かが欠けているわけではない。
   *
   * `← Newer` / `Older →` は向きの手がかりであって、唯一の手がかりではない。どちらが
   * 新しいかは添えた日付を読めば分かるため、読み上げの対象から外す。日付は1行の英語
   * （Mon, Sep 21, 2026）で見せ、読み上げには和文を渡す。
   */}
  <nav class="adjacent">
    {
      newer && (
        <a class="newer" href={hrefOf(newer.date)}>
          <span class="adjacent-word" aria-hidden="true">
            ← Newer
          </span>
          <time datetime={newer.date}>
            <span class="visually-hidden">{formatDateJa(newer.date)}</span>
            <span aria-hidden="true">{formatDateEn(newer.date)}</span>
          </time>
          {newer.title && <span class="entry-title">{newer.title}</span>}
        </a>
      )
    }
    {
      older && (
        <a class="older" href={hrefOf(older.date)}>
          <span class="adjacent-word" aria-hidden="true">
            Older →
          </span>
          <time datetime={older.date}>
            <span class="visually-hidden">{formatDateJa(older.date)}</span>
            <span aria-hidden="true">{formatDateEn(older.date)}</span>
          </time>
          {older.title && <span class="entry-title">{older.title}</span>}
        </a>
      )
    }
  </nav>

  <ListLinks
    links={[
      {
        href: `/${year}/${month}`,
        label: `${monthAbbrOf(month)} ${year}`,
        spoken: `${year}年${Number(month)}月の一覧`,
      },
      { href: `/${year}`, label: year, spoken: `${year}年の一覧` },
      { href: `/on-this-day/${monthDay}`, label: 'On this day', spoken: '過去の同じ日' },
    ]}
  />

  {/*
   * 本文の写真を拡大して見るための器。中身は空で、押された写真をスクリプトが
   * 流し込む。日別ページにしか写真は出ないので、読み込むのもこのページだけ。
   */}
  <PhotoZoom />
</Base>

<style>
  /*
   * 頭のまとまり。日付・題・場所をここに収め、本文との間はこのまとまりが空ける。
   * 間隔を持つのが最後の子ではなくまとまりの側なので、場所の行が増えても減っても
   * 本文までの間隔は変わらない。
   */
  .entry-head {
    margin-bottom: 2.6rem;
  }

  .dateline {
    margin: 0 0 1.7rem;
  }

  /*
   * 記事の題。タイトルのない日は、日付の部品を包む見出しになる。
   *
   * 行を目いっぱい使って折り返す。最後の行は短く終わってよい。
   *
   * 行の長さを揃える指定（`text-wrap: balance`）は使わない。揃えると、2行・3行になる
   * 題の各行が短く詰められ、列の右が空いて幅を狭めたように見える。たとえば 393px の
   * 画面では、3行の題が1行8字ほどに揃えられ、列の3割が空いていた。行の長さを揃える
   * のではなく、日記の本文と同じく列の幅いっぱいまで組む。
   */
  h1 {
    margin-bottom: 0;
    font-size: 1.85rem;
    line-height: 1.5;
  }

  /*
   * 場所。`Osaka, Japan` のような欧文のラベルなので、日付の添え書き（DateBlock の
   * 月・曜日）と同じ字面で組む。新しい大きさも色も増やさない。書かれたとおりに
   * 出し、和訳も整形もしない。
   */
  .location {
    margin: 0.95rem 0 0;
    color: var(--fg-muted);
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 0.74rem;
    line-height: 1.65;
    letter-spacing: 0.14em;
  }

  .body {
    /* 並べた画像どうしの間隔。表の外周にも同じだけ空くので、負のマージンで打ち消す。 */
    --grid-gap: 0.4rem;
  }

  .body :global(> :first-child) {
    margin-top: 0;
  }

  /*
   * 本文中に直接書かれた画像の並び。
   *
   * 旧サイトから引き継いだ記事は、画像を横に並べるために `table` を本文に直接
   * 書いている。Markdown では表せない配置のための記述であり、表ではない。
   *
   * `table-layout: fixed` にするのは列幅を等分するため。既定の自動レイアウトでは
   * 画像の実寸の比で列幅が決まり、並べた画像の大きさが揃わない。
   */
  .body :global(table) {
    width: calc(100% + 2 * var(--grid-gap));
    margin: calc(2rem - var(--grid-gap)) calc(-1 * var(--grid-gap));
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: var(--grid-gap);
  }

  .body :global(td) {
    padding: 0;
    vertical-align: top;
  }

  .body :global(td img) {
    display: block;
  }

  .body :global(figure) {
    margin: 2rem 0;
  }

  .body :global(figure img) {
    display: block;
  }

  /*
   * 画像に添えられた説明。
   *
   * `figcaption` は画像1枚に対する説明、行全体に及ぶセルは並び全体に対する説明で、
   * 読み手にとっては同じものなので体裁を揃える。画像の入るセルに `colspan` が
   * 付くことはないため、`td[colspan]` で説明の行だけを選べる。
   *
   * 左に寄せ、先頭に朱の「—」を添える。「—」は飾りなので読み上げない（`/` の後ろが
   * 読み上げの代わりの文字で、空にしてある。これを解さないブラウザは、手前の宣言を
   * 使う）。
   */
  .body :global(figcaption),
  .body :global(td[colspan]) {
    padding-top: 0.55rem;
    color: var(--fg-muted);
    font-size: 0.78rem;
    line-height: 1.7;
    letter-spacing: 0.04em;
    text-align: left;
  }

  .body :global(figcaption::before),
  .body :global(td[colspan]::before) {
    content: '— ';
    content: '— ' / '';
    color: var(--accent);
  }

  /*
   * 前後の導線。上に強い罫線を引き、行どうしは淡い罫線で分ける。
   *
   * 狭い画面では上下に積む。古い側は、片方しかない端のエントリでも右に寄せる。
   * ここで左に流れると、`Older →` が画面の左に現れて向きの手がかりが壊れる。
   */
  .adjacent {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-top: 4rem;
    border-top: 1px solid var(--fg);
    line-height: 1.6;
  }

  .adjacent a {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
  }

  .adjacent .older {
    align-items: flex-end;
    text-align: right;
  }

  .adjacent-word {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.45rem;
    line-height: 1.2;
  }

  .adjacent time {
    color: var(--fg-muted);
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 0.74rem;
    letter-spacing: 0.08em;
  }

  .adjacent .entry-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    font-feature-settings: 'palt' 1;
  }

  .adjacent a:hover .adjacent-word {
    color: var(--accent);
  }

  /*
   * 幅があるときは左右2列にする。古い側は常に右の列に置く。片方しかないときも
   * 列を詰めない。左右の題が長くても中ほどで触れ合わないよう、内側を少し空ける。
   */
  @media (min-width: 36rem) {
    .adjacent {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .adjacent .newer {
      padding-right: 0.75rem;
    }

    .adjacent .older {
      grid-column: 2;
      padding-left: 0.75rem;
    }
  }
</style>
