---
import EntryList from '../components/EntryList.astro'
import PageHead from '../components/PageHead.astro'
import Base from '../layouts/Base.astro'
import { recentEntries, years } from '../lib/site-data.js'

// エントリが1件もなくてもビルドは通り、ページも表示される。
const entries = await recentEntries()
const yearList = await years()
---

<Base title="apkas-diary" description="個人の日記">
  <PageHead word="Recent" title="最近の日記" />

  <EntryList entries={entries} />

  {
    yearList.length > 0 && (
      <>
        {/* Archive は飾りの英字。見出しとして読まれるのは「年別」だけにする。 */}
        <h2 class="section-title archive-title">
          <span class="section-title-word" aria-hidden="true">
            Archive
          </span>
          年別
        </h2>
        {/*
          年は数字だけを見せ、「年」は読み上げにだけ残す。読み上げる語は「2026年」を
          まるごと持たせる。数字に「年」だけを足す形にすると、読み上げ用の要素が
          ブロックとして扱われ、「2026 年」と間の空いた名前になる。
        */}
        <ul class="year-list">
          {yearList.map((year) => (
            <li>
              <a class="pill" href={`/${year}`}>
                <span aria-hidden="true">{year}</span>
                <span class="visually-hidden">{year}年</span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</Base>

<style>
  .archive-title {
    margin: 3.6rem 0 1.1rem;
  }

  .year-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
