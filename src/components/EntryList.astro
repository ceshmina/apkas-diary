---
import { dayOf, monthOf, yearOf } from '../lib/date.js'
import type { Entry } from '../lib/store/entry.js'
import DateBlock from './DateBlock.astro'

interface Props {
  entries: Entry[]
  /** 年をまたぐ一覧では年を、年内の一覧では省く。 */
  showYear?: boolean
  emptyMessage?: string
}

const { entries, showYear = true, emptyMessage = 'エントリはまだありません。' } = Astro.props

function hrefOf(date: string): string {
  return `/${yearOf(date)}/${monthOf(date)}/${dayOf(date)}`
}
---

{
  entries.length === 0 ? (
    <p class="muted">{emptyMessage}</p>
  ) : (
    <ul class="entry-list">
      {/*
       * タイトルのないエントリは日付だけを出す。日記に名前を付けない日のほうが多く、
       * タイトルの不在は欠落ではないため、「(無題)」のような文言では示さない。
       * 日別ページで日付そのものを見出しにするのと同じ扱いになる。
       */}
      {entries.map((entry) => (
        <li>
          <a href={hrefOf(entry.date)}>
            <DateBlock date={entry.date} showYear={showYear} />
            {entry.title && <span class="entry-title">{entry.title}</span>}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  /* 一覧の上には強い罫線を引き、行どうしは淡い罫線で分ける。 */
  .entry-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--fg);
  }

  .entry-list li {
    border-bottom: 1px solid var(--border);
  }

  /*
   * 行。日の数字を左に大きく置き、右に月・年と曜日、その下に題を置く。
   *
   * 日付の部品（DateBlock）は箱を外し（`display: contents`）、数字と添え書きを
   * この grid に直接並べる。題を添え書きの下に置くため。部品の中の要素には
   * この一覧の印が付かないので、`:global()` で届かせる。
   */
  .entry-list a {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr);
    grid-template-areas:
      'day meta'
      'day title';
    column-gap: 0.9rem;
    align-items: center;
    padding: 0.8rem 0;
    color: inherit;
    text-decoration: none;
  }

  .entry-list a :global(.date-block) {
    display: contents;
  }

  .entry-list a :global(.date-block-day) {
    grid-area: day;
    font-size: 2.55rem;
    line-height: 1;
  }

  /*
   * 月・年と曜日。狭い画面では1行に並べ、間に点を置く。2段にすると、題の行と
   * 合わせて行が3段になる。
   */
  .entry-list a :global(.date-block-meta) {
    grid-area: meta;
    align-self: end;
    padding-bottom: 0;
    color: var(--fg-muted);
    font-size: 0.7rem;
    line-height: 1.6;
    letter-spacing: 0.12em;
  }

  .entry-list a :global(.date-block-meta > span) {
    display: inline;
  }

  .entry-list a :global(.date-block-meta > span + span::before) {
    content: '· ';
  }

  /* 題のない行。添え書きを、数字の高さの真ん中に置く。 */
  .entry-list a :global(.date-block:only-child .date-block-meta) {
    grid-row: 1 / span 2;
    align-self: center;
  }

  /* エントリの題。並んだリンクの題にあたるので明朝で組む。 */
  .entry-title {
    grid-area: title;
    align-self: start;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.6;
    letter-spacing: 0.04em;
    font-feature-settings: 'palt' 1;
  }

  /* 触れた行は、日の数字が朱になり、題に朱の下線が出る。 */
  .entry-list a:hover :global(.date-block-day) {
    color: var(--accent);
  }

  .entry-list a:hover .entry-title {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.35em;
  }

  /* 本文の列が最大幅に達する幅から、数字・添え書き・題の3列にする。 */
  @media (min-width: 42.5rem) {
    .entry-list a {
      grid-template-columns: 3.6rem 8rem minmax(0, 1fr);
      grid-template-areas: 'day meta title';
      column-gap: 1.2rem;
    }

    .entry-list a :global(.date-block-day) {
      font-size: 2.8rem;
    }

    .entry-list a :global(.date-block-meta) {
      align-self: center;
    }

    .entry-list a :global(.date-block-meta > span) {
      display: block;
    }

    .entry-list a :global(.date-block-meta > span + span::before) {
      content: none;
    }

    .entry-list a :global(.date-block:only-child .date-block-meta) {
      grid-row: auto;
    }

    .entry-title {
      align-self: center;
    }
  }
</style>
