---
/**
 * エントリの一覧。トップ・年別・月別・月日ページが共有する。
 *
 * 行は日別ページへの1つのリンクで、日付の部品（DateBlock）・題・本文の写真の縮小画像を
 * 中に置く。
 *
 * **縮小画像は行のリンクの中に置く。** 押すと行と同じ日別ページへ移る。拡大のような、
 * 一覧のページの中で起きる動作は持たない。写真と向き合う場所は日別ページの拡大表示で、
 * 一覧はそこへ辿るための場所である。縮小画像ごとのリンクも `tabindex` も持たせないので、
 * キーボードで辿る位置は行ごとに1つのままである。
 *
 * **縮小画像は支援技術から外す。** 並びを `aria-hidden` で包み、`img` の `alt` は空に
 * する。行の名前は、これまでどおり日付（読み上げ用の和文）と題で決まる。本文に書かれた
 * 写真の説明（`alt`）も一覧では読ませない。説明は日別ページで写真とともに読むもので、
 * 行の名前に連ねると、旅行の日には1行が数十の説明の読み上げになる。
 *
 * 写真のない行には、並びの要素そのものを出さない。空の枠や空白で写真の不在を示さない
 * のは、題の不在を「(無題)」と書かないのと同じ扱いである。
 *
 * 日付はどの一覧でも年を含めて示す（`Sep 2026`）。年別・月別の一覧も同じ形にし、
 * 4つの一覧の行を同じ寸法で並べる。
 */
import { dayOf, monthOf, yearOf } from '../lib/date.js'
import { thumbnailsOf } from '../lib/site-data.js'
import type { Entry } from '../lib/store/entry.js'
import DateBlock from './DateBlock.astro'

interface Props {
  entries: Entry[]
  emptyMessage?: string
}

const { entries, emptyMessage = 'エントリはまだありません。' } = Astro.props

/**
 * 1行に載せる縮小画像の数。いちばん多く見える段（9.5 枚）を覆う 10 枚。それより後ろの
 * 写真はどの幅でも見えないので、HTML にも載せない。
 */
const THUMBNAILS_PER_ROW = 10

const rows = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    thumbnails: (await thumbnailsOf(entry)).slice(0, THUMBNAILS_PER_ROW),
  })),
)

function hrefOf(date: string): string {
  return `/${yearOf(date)}/${monthOf(date)}/${dayOf(date)}`
}
---

{
  rows.length === 0 ? (
    <p class="muted">{emptyMessage}</p>
  ) : (
    <ul class="entry-list">
      {/*
       * タイトルのないエントリは日付だけを出す。日記に名前を付けない日のほうが多く、
       * タイトルの不在は欠落ではないため、「(無題)」のような文言では示さない。
       * 日別ページで日付そのものを見出しにするのと同じ扱いになる。
       *
       * 題のない行・写真のある行には印の class を付け、grid の組み方をそれで決める。
       * 子の数や並びから推し量る形（`:only-child` など）は、行に子が増えるたびに崩れる。
       */}
      {rows.map(({ entry, thumbnails }) => (
        <li>
          <a
            href={hrefOf(entry.date)}
            class:list={{ 'is-untitled': !entry.title, 'has-photos': thumbnails.length > 0 }}
          >
            <DateBlock date={entry.date} />
            {entry.title && <span class="entry-title">{entry.title}</span>}
            {thumbnails.length > 0 && (
              <span class="entry-photos" aria-hidden="true">
                {thumbnails.map((src) => (
                  <img src={src} alt="" width="240" height="240" loading="lazy" decoding="async" />
                ))}
              </span>
            )}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  /* 一覧の上には強い罫線を引き、行どうしは淡い罫線で分ける。 */
  .entry-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--fg);
  }

  .entry-list li {
    border-bottom: 1px solid var(--border);
  }

  /*
   * 行。日の数字を左に大きく置き、右に月・年と曜日、その下に題を置く。
   *
   * 日付の部品（DateBlock）は箱を外し（`display: contents`）、数字と添え書きを
   * この grid に直接並べる。題を添え書きの下に置くため。部品の中の要素には
   * この一覧の印が付かないので、`:global()` で届かせる。
   */
  .entry-list a {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr);
    grid-template-areas:
      'day meta'
      'day title';
    column-gap: 0.9rem;
    align-items: center;
    padding: 0.8rem 0;
    color: inherit;
    text-decoration: none;
  }

  /* 写真のある行。縮小画像は題の下に、3段目として並べる。 */
  .entry-list a.has-photos {
    grid-template-areas:
      'day meta'
      'day title'
      '. photos';
  }

  /*
   * 題のない、写真のある行。縮小画像を題の位置に並べる。行は2段のまま中身を持つので、
   * 題のない行の続く一覧でも間延びしない。
   */
  .entry-list a.has-photos.is-untitled {
    grid-template-areas:
      'day meta'
      'day photos';
  }

  .entry-list a :global(.date-block) {
    display: contents;
  }

  .entry-list a :global(.date-block-day) {
    grid-area: day;
    font-size: 2.55rem;
    line-height: 1;
  }

  /*
   * 月・年と曜日。狭い画面では1行に並べ、間に点を置く。2段にすると、題の行と
   * 合わせて行が3段になる。
   */
  .entry-list a :global(.date-block-meta) {
    grid-area: meta;
    align-self: end;
    padding-bottom: 0;
    color: var(--fg-muted);
    font-size: 0.7rem;
    line-height: 1.6;
    letter-spacing: 0.12em;
  }

  .entry-list a :global(.date-block-meta > span) {
    display: inline;
  }

  .entry-list a :global(.date-block-meta > span + span::before) {
    content: '· ';
  }

  /* 題も写真もない行。添え書きを、数字の高さの真ん中に置く。 */
  .entry-list a.is-untitled:not(.has-photos) :global(.date-block-meta) {
    grid-row: 1 / span 2;
    align-self: center;
  }

  /* エントリの題。並んだリンクの題にあたるので明朝で組む。 */
  .entry-title {
    grid-area: title;
    align-self: start;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.6;
    letter-spacing: 0.04em;
    font-feature-settings: 'palt' 1;
  }

  /*
   * 本文の写真の縮小画像の並び。
   *
   * 枚数では切らない。縮小画像は正方形で、大きさは**列の幅にちょうど「N 枚と半分」が
   * 入る値**にする。入りきらない行だけ、半分見えている最後の1枚が地の白に溶けていく。
   * 入りきる行には溶かしを当てず、続きがあるように見せない。
   *
   * 半端な「N 枚と半分」にするのは、入りきるかどうかを枚数だけで決めるため。大きさを
   * 固定の値にすると、1行に入る枚数が画面の幅で1枚ずつ変わり、「この行は入りきらない」
   * を CSS だけでは見分けられない。枚数で幅を割れば、N+1 枚目の有無がそのまま入りきら
   * ないことになり、`:has()` で見分けられる。スクリプトは使わない。`:has()` や
   * `mask-image` を解さないブラウザでは溶かしが当たらず、半分の1枚が切れて見えるだけで、
   * 並びは崩れない。
   *
   * `-webkit-mask-image` は並べて書かない。CSS の圧縮が、打ち消しの `none` の側だけ
   * 接頭辞つきを落とす（いまのブラウザでは同じプロパティの別名なので）。別のものとして
   * 扱う古いブラウザでは、入りきる行に溶かしが残ることになる。溶かしが無いほうが安全である。
   *
   * N は画面の幅で段を変え、大きさをどの幅でも 36〜58px ほどに保つ。N を1つに固定すると、
   * 大きさは列の幅に比例して伸び続け、PC の組みに替わる手前で約 100px になる。
   *
   *   〜27rem     5.5 枚   約 36〜56px
   *   〜34.5rem   7.5 枚   約 40〜56px
   *   〜42.5rem   9.5 枚   約 44〜58px
   *   PC          8.5 枚   約 56px
   *
   * 段が上がるたびに、下の段での溶かしの当て方を打ち消す。
   */
  .entry-photos {
    --visible: 5;
    --gap: 3px;
    --cell: calc((100% - var(--visible) * var(--gap)) / (var(--visible) + 0.5));
    /* 溶かしの形。mask は不透明度だけを読むので、色は何でもよい。 */
    --fade: linear-gradient(to right, #000 calc(100% - 1.15 * var(--cell)), transparent);

    grid-area: photos;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: var(--cell);
    gap: var(--gap);
    margin-top: 0.5rem;
    overflow: hidden;
  }

  .entry-list a.is-untitled .entry-photos {
    margin-top: 0.3rem;
  }

  /*
   * 縮小画像そのもの。角は立て（tokens.css は写真の縮小画像を角を立てるものに数えて
   * いる）、読み込みを待つあいだは罫線の色の面を置く。読み込めなかったときも、その面が
   * 残るだけで行は崩れない。
   *
   * 縮小画像そのものにホバーの手応えは付けない。行に触れたときの手応え（日の数字が朱、
   * 題に朱の下線）が、縮小画像に触れたときにも出る。
   */
  .entry-photos img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--border);
  }

  .entry-photos:has(> img:nth-child(6)) {
    mask-image: var(--fade);
  }

  @media (min-width: 27rem) {
    .entry-photos {
      --visible: 7;
    }

    .entry-photos:has(> img:nth-child(6)) {
      mask-image: none;
    }

    .entry-photos:has(> img:nth-child(8)) {
      mask-image: var(--fade);
    }
  }

  @media (min-width: 34.5rem) {
    .entry-photos {
      --visible: 9;
    }

    .entry-photos:has(> img:nth-child(8)) {
      mask-image: none;
    }

    .entry-photos:has(> img:nth-child(10)) {
      mask-image: var(--fade);
    }
  }

  /* 触れた行は、日の数字が朱になり、題に朱の下線が出る。 */
  .entry-list a:hover :global(.date-block-day) {
    color: var(--accent);
  }

  .entry-list a:hover .entry-title {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.35em;
  }

  /*
   * 本文の列が最大幅に達する幅から、数字・添え書き・題の3列にする。縮小画像は題の列に
   * 並べる（題のある行は題の下、題のない行は題の位置）。
   *
   * 列の幅は字面の幅から決めている。ブラウザで測ったいちばん広い字面に、少し余りを足す。
   *
   *   数字      2.8rem でいちばん広い「20」が 37.2px                   → 2.4rem（38.4px）
   *   添え書き  0.7rem でいちばん広い「May 2026」「Dec 2026」が 65.8px  → 4.25rem（68px）
   *
   * 書体のファイルの送り幅から計算すると「May 2026」は 61.8px だが、字ごとの送り幅を整数の
   * 画素に丸める環境（Linux の Chromium など）では 4px ほど広く出る。余りはそのぶんである。
   * 添え書きはどの一覧も年を含むので、列の幅は1つで足りる。数字は左に寄せ、一覧の左端
   * （上の罫線の始まり）に揃える。1桁の日は数字と添え書きの間が広くなるが、添え書きの
   * 列が縦に揃うほうを取る。
   */
  @media (min-width: 42.5rem) {
    .entry-list a {
      grid-template-columns: 2.4rem 4.25rem minmax(0, 1fr);
      grid-template-areas: 'day meta title';
      column-gap: 1rem;
    }

    .entry-list a.has-photos {
      grid-template-areas:
        'day meta title'
        '. . photos';
    }

    .entry-list a.has-photos.is-untitled {
      grid-template-areas: 'day meta photos';
    }

    .entry-list a :global(.date-block-day) {
      font-size: 2.8rem;
    }

    .entry-list a :global(.date-block-meta) {
      align-self: center;
    }

    /*
     * 列の余りは 2px ほどしかない。書体の読み込みを待つあいだの代わりの書体が少し
     * 広くても、折り返して行の高さを変えないようにする。
     */
    .entry-list a :global(.date-block-meta > span) {
      display: block;
      white-space: nowrap;
    }

    .entry-list a :global(.date-block-meta > span + span::before) {
      content: none;
    }

    .entry-list a.is-untitled:not(.has-photos) :global(.date-block-meta) {
      grid-row: auto;
    }

    .entry-title {
      align-self: center;
    }

    .entry-list a.is-untitled .entry-photos {
      margin-top: 0;
    }

    .entry-photos {
      --visible: 8;
    }

    .entry-photos:has(> img:nth-child(9)) {
      mask-image: var(--fade);
    }
  }
</style>
