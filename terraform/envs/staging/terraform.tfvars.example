# このファイルを terraform.tfvars にコピーして実値を埋める。
# terraform.tfvars は .gitignore によりコミットされない。

aws_region  = "ap-northeast-1"
aws_profile = "apkas-diary-staging"

# staging の AWS アカウント ID（12桁）。
# 間違えると production を操作してしまうため、必ず確認してから入れる。
#   aws sts get-caller-identity --profile apkas-diary-staging
aws_account_id = "000000000000"
