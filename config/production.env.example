# production 環境の設定。
# このファイルを `config/production.env` にコピーして実値を埋める。
# `config/production.env` は .gitignore によりコミットされない。

# --- AWS ---
# 操作対象の環境を決める named profile。
# SSO なので、期限が切れたら aws sso login --profile apkas-production.admin を実行する。
AWS_PROFILE=apkas-production.admin
AWS_REGION=ap-northeast-1

# --- DynamoDB ---
# terraform output の table_name と一致させる。
DIARY_TABLE_NAME=apkas-diary-production

# --- 配信先（terraform apply 後に output から転記する）---
SITE_BUCKET=
CLOUDFRONT_DISTRIBUTION_ID=

# 独自ドメイン。CloudFront が払い出すドメインではなく output の site_url を転記する。
# 現状のテンプレートは絶対 URL を出力しないため生成物には現れないが、canonical や
# OGP を入れたときにここが参照される。
#   SITE_URL=https://diary.apkas.net
SITE_URL=

# --- 写真（terraform apply 後に output から転記する）---
# 元写真を投入する先。npm run photo が置く。
PHOTO_UPLOAD_BUCKET=

# 派生画像が置かれるバケット。書き込むのは Lambda だけで、npm run photo は
# 生成が終わったかを見るために読むだけ。
PHOTO_BUCKET=

# 写真の配信 URL の基点。output の photo_url を転記する。
#   PHOTO_URL=https://photos.apkas.net
PHOTO_URL=

# --- サイト設定 ---
# トップページに表示する最新エントリの件数。
DIARY_RECENT_COUNT=20

# --- 編集アプリケーション ---
# ここに足すものはない。
#
# 編集アプリケーションが読む設定（OAuth クライアント・署名鍵・許可アカウント）は
# SSM Parameter Store にあり、実行時に取りにいく。秘密をこのファイルに置かない。
# 自分の URL とパラメータのパスは、Lambda では editor/function.jsonnet が
# tfstate から、手元では scripts/dev-editor.sh が環境名から決める。
#
# 読み書きの対象は上の DIARY_TABLE_NAME と AWS_PROFILE がそのまま使われる。
