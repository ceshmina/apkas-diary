# staging 環境の設定。
# このファイルを `config/staging.env` にコピーして実値を埋める。
# `config/staging.env` は .gitignore によりコミットされない。

# --- AWS ---
# 操作対象の環境を決める named profile。
# SSO なので、期限が切れたら aws sso login --profile apkas-staging.admin を実行する。
AWS_PROFILE=apkas-staging.admin
AWS_REGION=ap-northeast-1

# --- DynamoDB ---
# terraform output の table_name と一致させる。
DIARY_TABLE_NAME=apkas-diary-staging

# --- 配信先（terraform apply 後に output から転記する）---
SITE_BUCKET=
CLOUDFRONT_DISTRIBUTION_ID=

# 独自ドメイン。CloudFront が払い出すドメインではなく output の site_url を転記する。
# 現状のテンプレートは絶対 URL を出力しないため生成物には現れないが、canonical や
# OGP を入れたときにここが参照される。
#   SITE_URL=https://diary.dev.apkas.net
SITE_URL=

# --- サイト設定 ---
# トップページに表示する最新エントリの件数。
DIARY_RECENT_COUNT=20
